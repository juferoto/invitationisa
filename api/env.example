# Plantilla de configuración. Copia este archivo a `.env.local` y rellena los
# valores; `.env.local` está fuera del repositorio y ahí es donde van los
# secretos. Nunca escribas una clave real en este archivo.
#
#     cp api/env.example api/.env.local
#
# En producción estos mismos nombres se cargan en el panel del hosting, no en
# un archivo.

# ---------------------------------------------------------------- servidor
ADDR=:8080
# Desde dónde llama el navegador. En producción, el dominio de Vercel.
CORS_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:3000
# Firma las sesiones del panel. Genérala con: openssl rand -base64 32
JWT_SECRET=
# Solo se usan la primera vez, para crear el usuario del panel.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ------------------------------------------------------------ base de datos
# En local, un archivo SQLite. En producción, Turso:
#   turso db show <base> --url        -> libsql://<base>-<cuenta>.turso.io
#   turso db tokens create <base>     -> el token
# y se juntan así:  libsql://…turso.io?authToken=<token>
DATABASE_DSN=file:data/invitation.db?_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)

# ---------------------------------------------------------------- medios
# `local` guarda en disco; `cloudinary` sube al almacén externo.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/media
STORAGE_BASE_URL=http://localhost:8080/media

# Cloudinary: consola -> el nombre está en el panel principal, la clave y el
# secreto en Configuración -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cualquier almacén compatible con S3 (R2, B2, MinIO). Alternativa a Cloudinary.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
