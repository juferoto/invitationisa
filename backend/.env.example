ADDR=:8080
DATABASE_DSN=file:data/invitation.db?_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)&_pragma=foreign_keys(1)

# Base del frontend: se usa para construir los links de cada invitado.
PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Almacenamiento de medios: "local" en desarrollo, "s3" para Cloudflare R2.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/media
STORAGE_BASE_URL=http://localhost:8080/media

# Solo con STORAGE_DRIVER=s3
# S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=invitaciones
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# STORAGE_BASE_URL=https://media.tudominio.com

MAX_UPLOAD_BYTES=134217728

# Clave con la que se firman los JWT de la sesión del panel. Obligatoria en
# producción: sin ella se genera una al azar en cada arranque y todo el mundo
# queda desconectado al reiniciar. Genérala con:
#   openssl rand -base64 32
JWT_SECRET=

# "lax" cuando el panel y la API comparten dominio; "none" cuando están en
# dominios distintos (Vercel + Fly.io), o el navegador no mandará la cookie.
COOKIE_SAMESITE=lax

# Se usan una sola vez, cuando la tabla de admins está vacía.
SEED_ADMIN_EMAIL=admin@local
SEED_ADMIN_PASSWORD=cambiame
